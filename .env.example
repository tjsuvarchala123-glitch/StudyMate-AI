# StudyMate AI Configuration
# Copy this file to .env in the backend folder or workspace root to enable optional live LLM providers

# Port Configuration
PORT=8000
HOST=127.0.0.1

# Optional AI Providers (If left empty, StudyMate operates in Demo Mode with local semantic rule engine)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Application Mode
APP_ENV=development
